# Copy to .env and fill in ONE of the keys below, then restart `npm run dev`.

# Free: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid (better advice): https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=

# Optional
# NUXT_COACH_PROVIDER=auto        # auto | gemini | claude (auto = Gemini if its key is set)
# Free models tried in order, the next one is used when one is out of quota:
# NUXT_GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# NUXT_CLAUDE_MODEL=claude-opus-5-5
# NUXT_CLAUDE_EFFORT=low
